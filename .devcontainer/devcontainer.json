{
  "name": "T3 Code Dev",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "workspace",
  "workspaceFolder": "/workspaces/t3code",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers-extra/features/bun:1": {
      "version": "1.3.11"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24.13.1"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.10",
      "installTools": false
    }
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/git",
    "ghcr.io/devcontainers-extra/features/bun"
  ],
  "postCreateCommand": {
    "bun-install": "bun install --backend=copyfile --frozen-lockfile",
    "devcontainer-cli": "bun install -g @devcontainers/cli@0.86.0"
  },
  "forwardPorts": [5733, 13773],
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode"]
    }
  }
}
